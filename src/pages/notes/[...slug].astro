---
// src/pages/notes/[...slug].astro
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes');
  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

interface Props {
  note: CollectionEntry<'notes'>;
}

const { note } = Astro.props;
const { data, render } = note;
const { Content } = await render();
---

<Layout
  title={`${data.title} — Engineering Note`}
  description={data.description}
  type="article"
>
  <article class="max-w-3xl mx-auto space-y-8">
    
    <!-- Header -->
    <div class="space-y-4 border-b border-slate-200 dark:border-slate-800 pb-6">
      <div class="flex items-center justify-between text-xs font-mono text-slate-500">
        <a href="/notes" class="hover:text-slate-900 dark:hover:text-slate-100 flex items-center gap-1">
          <span>←</span>
          <span>Back to all notes</span>
        </a>
        <div class="flex items-center gap-2">
          <time datetime={data.pubDate.toISOString()}>
            {data.pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          <span>•</span>
          <span>{data.readingTime}</span>
        </div>
      </div>

      <h1 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-slate-900 dark:text-slate-100">
        {data.title}
      </h1>

      <p class="text-base text-slate-600 dark:text-slate-300 leading-relaxed font-sans">
        {data.description}
      </p>

      <div class="flex flex-wrap gap-1.5 pt-2">
        {data.tags.map((tag) => (
          <span class="px-2 py-0.5 text-xs font-mono rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400">
            #{tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Article Body -->
    <div class="prose prose-slate dark:prose-invert max-w-none text-sm sm:text-base leading-relaxed">
      <Content />
    </div>

    <!-- Article Footer -->
    <footer class="pt-8 border-t border-slate-200 dark:border-slate-800 flex justify-between items-center text-xs font-mono">
      <a href="/notes" class="text-blue-600 dark:text-blue-400 hover:underline">
        ← Back to all Notes
      </a>
      <a href="https://www.linkedin.com/in/zul-yatman" target="_blank" rel="noopener noreferrer" class="text-slate-500 hover:text-slate-900 dark:hover:text-slate-100">
        Discuss on LinkedIn →
      </a>
    </footer>

  </article>
</Layout>
