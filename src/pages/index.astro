---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SkillMatrix from '../components/SkillMatrix.astro';
import { getCollection } from 'astro:content';

const projects = await getCollection('projects');
const featuredProjects = projects.sort((a, b) => a.data.order - b.data.order).slice(0, 3);

const notes = await getCollection('notes');
const recentNotes = notes.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---

<Layout title="Zul Yatman — Senior Software Engineer & QA Automation Architect">
  <div class="space-y-16 sm:space-y-24">
    
    <!-- Hero Section -->
    <section class="space-y-6 pt-4 sm:pt-8">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-full text-xs font-mono bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span>Senior Software Engineer & QA Architect</span>
        <span class="text-slate-400">/</span>
        <span class="text-slate-500">Jakarta & Bandung (Hybrid)</span>
      </div>

      <!-- Headline -->
      <div class="space-y-3">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-slate-900 dark:text-slate-50 leading-[1.15]">
          Engineering high-resilience systems & automated quality architecture.
        </h1>
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-3xl leading-relaxed">
          I'm <strong class="text-slate-900 dark:text-slate-100 font-semibold">Zul Yatman</strong>. Over 10+ years across e-commerce, core banking, video streaming, and omnichannel retail, I design mission-critical order sync engines, distributed k6 performance frameworks, and zero-defect deployment pipelines.
        </p>
      </div>

      <!-- Key Impact Metrics Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 pt-2">
        <div class="p-3.5 sm:p-4 rounded-lg border border-slate-200 dark:border-slate-800/90 bg-white dark:bg-[#111622]">
          <div class="text-2xl sm:text-3xl font-bold font-mono text-slate-900 dark:text-slate-100">10+ <span class="text-sm font-normal text-slate-500">Yrs</span></div>
          <div class="text-xs font-mono text-slate-500 dark:text-slate-400 mt-1">Production Experience</div>
        </div>
        <div class="p-3.5 sm:p-4 rounded-lg border border-slate-200 dark:border-slate-800/90 bg-white dark:bg-[#111622]">
          <div class="text-2xl sm:text-3xl font-bold font-mono text-emerald-600 dark:text-emerald-400">0%</div>
          <div class="text-xs font-mono text-slate-500 dark:text-slate-400 mt-1">Order Loss in Flash Sales</div>
        </div>
        <div class="p-3.5 sm:p-4 rounded-lg border border-slate-200 dark:border-slate-800/90 bg-white dark:bg-[#111622]">
          <div class="text-2xl sm:text-3xl font-bold font-mono text-blue-600 dark:text-blue-400">40s → 5s</div>
          <div class="text-xs font-mono text-slate-500 dark:text-slate-400 mt-1">Test Suite Latency Optimization</div>
        </div>
        <div class="p-3.5 sm:p-4 rounded-lg border border-slate-200 dark:border-slate-800/90 bg-white dark:bg-[#111622]">
          <div class="text-2xl sm:text-3xl font-bold font-mono text-slate-900 dark:text-slate-100">10K+</div>
          <div class="text-xs font-mono text-slate-500 dark:text-slate-400 mt-1">Simulated RPM Performance</div>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="/experience"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-slate-900 hover:bg-slate-800 dark:bg-slate-100 dark:hover:bg-white text-white dark:text-slate-900 text-xs font-mono font-medium transition-colors"
        >
          <span>View Career History</span>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a
          href="/projects"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-md border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800/60 text-slate-700 dark:text-slate-300 text-xs font-mono font-medium transition-colors"
        >
          <span>Case Studies</span>
        </a>
        <a
          href="/resume"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-md border border-slate-200 dark:border-slate-800 hover:bg-slate-100 dark:hover:bg-slate-800/60 text-slate-700 dark:text-slate-300 text-xs font-mono font-medium transition-colors"
        >
          <span>Resume (CV)</span>
        </a>
      </div>
    </section>

    <!-- Featured Case Studies Section -->
    <section class="space-y-6">
      <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
        <div>
          <h2 class="text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100 font-mono">
            Featured Case Studies
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Real architectural challenges, trade-offs, and measurable business outcomes.
          </p>
        </div>
        <a
          href="/projects"
          class="text-xs font-mono text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1"
        >
          <span>All Case Studies</span>
          <span>→</span>
        </a>
      </div>

      {featuredProjects.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          {featuredProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      ) : (
        <div class="p-6 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111622] text-sm text-slate-500 font-mono">
          Case studies are currently being indexed. View <a href="/experience" class="text-blue-500 underline">career experience</a>.
        </div>
      )}
    </section>

    <!-- Technical Competencies & Matrix -->
    <section class="space-y-6">
      <div class="border-b border-slate-200 dark:border-slate-800 pb-3">
        <h2 class="text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100 font-mono">
          Engineering Competencies & Tooling
        </h2>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
          Domain expertise categorized by architectural responsibility — without arbitrary percentage bars.
        </p>
      </div>

      <SkillMatrix />
    </section>

    <!-- Recent Engineering Notes Section -->
    <section class="space-y-6">
      <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
        <div>
          <h2 class="text-lg font-semibold tracking-tight text-slate-900 dark:text-slate-100 font-mono">
            Recent Engineering Notes
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">
            Deep dives into distributed systems, load testing strategies, and quality engineering.
          </p>
        </div>
        <a
          href="/notes"
          class="text-xs font-mono text-blue-600 dark:text-blue-400 hover:underline flex items-center gap-1"
        >
          <span>All Notes</span>
          <span>→</span>
        </a>
      </div>

      {recentNotes.length > 0 ? (
        <div class="divide-y divide-slate-100 dark:divide-slate-800/80">
          {recentNotes.map((note) => (
            <article class="py-4 group">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1">
                <a
                  href={`/notes/${note.slug}`}
                  class="text-sm font-semibold text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors"
                >
                  {note.data.title}
                </a>
                <div class="text-xs font-mono text-slate-400 shrink-0">
                  {note.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })} • {note.data.readingTime}
                </div>
              </div>
              <p class="mt-1 text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                {note.data.description}
              </p>
            </article>
          ))}
        </div>
      ) : (
        <div class="p-6 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111622] text-sm text-slate-500 font-mono">
          Engineering articles and post-mortems publishing soon.
        </div>
      )}
    </section>

    <!-- Contact & Direct Outreach -->
    <section class="p-6 sm:p-8 rounded-lg border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-[#111622]/60 space-y-4">
      <div class="space-y-1">
        <h2 class="text-base sm:text-lg font-semibold text-slate-900 dark:text-slate-100 font-mono">
          Interested in discussing architecture or performance engineering?
        </h2>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400">
          Whether you need advice on decoupling legacy order systems, designing high-concurrency automated test suites, or building resilient omnichannel infrastructure, reach out directly.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3 pt-2">
        <a
          href="mailto:contact@zulyatman.com"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-md bg-blue-600 hover:bg-blue-700 text-white text-xs font-mono font-medium transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          <span>contact@zulyatman.com</span>
        </a>
        <a
          href="https://linkedin.com/in/zulyatman"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-md border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-mono font-medium transition-colors"
        >
          <span>Connect on LinkedIn</span>
        </a>
      </div>
    </section>

  </div>
</Layout>
