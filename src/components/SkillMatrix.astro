---
// SkillMatrix.astro
interface SkillCategory {
  title: string;
  description: string;
  items: Array<{
    name: string;
    details?: string;
  }>;
}

const skillCategories: SkillCategory[] = [
  {
    title: 'Test Automation & QA Architecture',
    description: 'Automated test frameworks, distributed load testing, CI/CD quality gates, and AI-augmented testing.',
    items: [
      { name: 'Playwright & Cypress', details: 'End-to-end resilient web testing suites & contract testing' },
      { name: 'Robot Framework, Appium & Selenium', details: 'Cross-platform mobile (Android/iOS) and web test automation' },
      { name: 'k6 (Distributed Load Testing)', details: 'High-concurrency benchmarking (10,000+ RPM), bottleneck analysis' },
      { name: 'AI-Augmented Engineering', details: 'Agentic AI workflows, MCP protocol, autonomous test execution' },
      { name: 'Postman, Newman & TestNG', details: 'API testing, table-driven test suites, shift-left quality gates' },
    ],
  },
  {
    title: 'Backend Systems & Omnichannel Architecture',
    description: 'High-concurrency services, event-driven pipelines, dynamic pricing engines, and distributed caching.',
    items: [
      { name: 'Go (Golang) & Python', details: 'High-throughput microservices, event consumers, CLI tooling' },
      { name: 'TypeScript & JavaScript (Node.js)', details: 'REST APIs, automation tooling, backend services' },
      { name: 'Ruby on Rails & Java', details: 'Dynamic fee engines, core banking systems (ISO8583)' },
      { name: 'Redis Cluster', details: 'Distributed locking, idempotency engines, multi-layer caching' },
      { name: 'PostgreSQL, MySQL & Oracle DB', details: 'Schema design, transaction rollbacks, data integrity' },
      { name: 'Kafka, gRPC & Webhooks', details: 'Event streaming, HMAC signature verification, DLQ routing' },
    ],
  },
  {
    title: 'DevOps, CI/CD & Systems Infrastructure',
    description: 'Container orchestration, CI/CD pipelines, observability metrics, and industrial telemetry.',
    items: [
      { name: 'Docker & Kubernetes', details: 'Parallelized test grids, containerized microservices' },
      { name: 'GitLab CI & GitHub Actions', details: 'Zero-defect deployment pipelines, release quality gates' },
      { name: 'Jenkins & Datadog', details: 'Scheduled CI runs, APM tracing, alerting & latency budgets' },
      { name: 'Linux / Unix & Bash', details: 'System automation, kernel tuning, network troubleshooting' },
      { name: 'Domains & Protocols', details: 'Omnichannel POS/OMS, E-Commerce, Fintech, ISO8583, DRM/HLS' },
    ],
  },
];
---

<div class="space-y-6">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {
      skillCategories.map((category) => (
        <div class="p-5 rounded-lg border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111622]/80 flex flex-col justify-between">
          <div>
            <h3 class="text-sm font-semibold font-mono text-slate-900 dark:text-slate-100 pb-2 border-b border-slate-100 dark:border-slate-800">
              {category.title}
            </h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 mb-4 leading-relaxed">
              {category.description}
            </p>
            <ul class="space-y-2.5">
              {category.items.map((skill) => (
                <li class="text-xs">
                  <div class="font-mono font-medium text-slate-800 dark:text-slate-200 flex items-center gap-1.5">
                    <span class="w-1 h-1 rounded-full bg-blue-500"></span>
                    <span>{skill.name}</span>
                  </div>
                  {skill.details && (
                    <div class="text-[11px] text-slate-500 dark:text-slate-400 pl-2.5 font-sans mt-0.5">
                      {skill.details}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))
    }
  </div>
</div>
