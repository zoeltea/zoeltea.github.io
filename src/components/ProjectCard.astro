---
// ProjectCard.astro
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  detailed?: boolean;
}

const { project, detailed = false } = Astro.props;
const { data, slug } = project;
---

<div class="group relative flex flex-col justify-between p-5 sm:p-6 rounded-lg border border-slate-200 dark:border-slate-800/90 bg-white dark:bg-[#111622] hover:border-slate-300 dark:hover:border-slate-700 transition-all duration-200">
  <div class="space-y-3">
    <!-- Header meta: Category & Period -->
    <div class="flex items-center justify-between text-xs font-mono text-slate-500 dark:text-slate-400">
      <span class="inline-flex items-center gap-1.5 font-medium text-blue-600 dark:text-blue-400">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-500"></span>
        {data.category}
      </span>
      <span>{data.period}</span>
    </div>

    <!-- Title & Link -->
    <div>
      <h3 class="text-base sm:text-lg font-semibold text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
        <a href={`/projects/${slug}`} class="focus:outline-none">
          <span class="absolute inset-0" aria-hidden="true"></span>
          {data.title}
        </a>
      </h3>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
        {data.description}
      </p>
    </div>

    <!-- Impact Metrics List -->
    {data.impactMetrics && data.impactMetrics.length > 0 && (
      <div class="pt-2 border-t border-slate-100 dark:border-slate-800/60">
        <span class="text-xs font-mono font-medium text-slate-500 dark:text-slate-400 block mb-1.5">
          Key Impact:
        </span>
        <ul class="space-y-1">
          {data.impactMetrics.map((metric) => (
            <li class="text-xs font-mono text-slate-700 dark:text-slate-300 flex items-start gap-1.5">
              <span class="text-emerald-500 font-bold">✓</span>
              <span>{metric}</span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <!-- Tech Stack Chips & Link arrow -->
  <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-800/60 flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap gap-1.5">
      {data.stack.slice(0, 4).map((tech) => (
        <span class="px-2 py-0.5 text-xs font-mono rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 border border-slate-200/60 dark:border-slate-700/50">
          {tech}
        </span>
      ))}
      {data.stack.length > 4 && (
        <span class="px-1.5 py-0.5 text-xs font-mono text-slate-400 dark:text-slate-500">
          +{data.stack.length - 4}
        </span>
      )}
    </div>

    <div class="text-xs font-mono text-slate-400 group-hover:text-blue-600 dark:group-hover:text-blue-400 flex items-center gap-1 transition-colors">
      <span>Deep Dive</span>
      <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </div>
  </div>
</div>
