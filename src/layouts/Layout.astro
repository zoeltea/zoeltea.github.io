---
// Layout.astro
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
}

const {
  title,
  description = 'Zul Yatman — Lead Test Engineer (SDET & Test Architecture) / Software Engineer with 10+ years designing high-throughput order fulfillment, distributed testing, and core fintech services.',
  image = '/og-image.png',
  type = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://zoeltea.github.io');
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title ? `${title} | Zul Yatman` : 'Zul Yatman — Lead Test Engineer (SDET & Test Architecture) / Software Engineer'}</title>
    <meta name="title" content={title ? `${title} | Zul Yatman` : 'Zul Yatman — Lead Test Engineer (SDET & Test Architecture) / Software Engineer'} />
    <meta name="description" content={description} />
    <meta name="author" content="Zul Yatman" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title ? `${title} | Zul Yatman` : 'Zul Yatman — Lead Test Engineer (SDET & Test Architecture) / Software Engineer'} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, canonicalURL)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title ? `${title} | Zul Yatman` : 'Zul Yatman — Lead Test Engineer (SDET & Test Architecture) / Software Engineer'} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, canonicalURL)} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Theme Initialization Script (Prevents FOUC) -->
    <script is:inline>
      (function () {
        const theme = localStorage.getItem('theme');
        if (
          theme === 'dark' ||
          (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body class="bg-[#ffffff] dark:bg-[#0a0d14] text-slate-900 dark:text-slate-100 flex flex-col min-h-screen antialiased selection:bg-blue-500/20 selection:text-blue-600 dark:selection:text-blue-300">
    <Header />
    <main class="flex-grow w-full max-w-5xl mx-auto px-4 sm:px-6 py-8 md:py-12">
      <slot />
    </main>
    <Footer />
  </body>
</html>
